# Clean UAE (تنظيف الفخامة) — Environment Configuration Template
APP_NAME="Clean UAE"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cleanuae_db
DB_USER=root
DB_PASS=

# Security & Tokens
APP_SECRET=clean_uae_super_secure_random_key_production_2026_xyz
SESSION_LIFETIME_HOURS=24
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=3

# Storage Paths
UPLOAD_DIR=uploads/

# CORS Settings (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://localhost"
